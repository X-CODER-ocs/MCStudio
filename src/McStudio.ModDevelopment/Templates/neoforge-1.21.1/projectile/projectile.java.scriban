@OnlyIn(value = Dist.CLIENT, _interface = ItemSupplier.class)
public class {{ registryname }}Entity extends AbstractArrow implements ItemSupplier {

    public static final ItemStack PROJECTILE_ITEM = {{ projectile_item }};

    {{ if disable_gravity }}
    private int knockback = 0;
    {{ end }}

    public {{ registryname }}Entity(EntityType<? extends {{ registryname }}Entity> type, Level world) {
        super(type, world);
        {{ if disable_gravity }}setNoGravity(true);{{ end }}
    }

    public {{ registryname }}Entity(EntityType<? extends {{ registryname }}Entity> type, double x, double y, double z, Level world, ItemStack firedFromWeapon) {
        super(type, x, y, z, world, PROJECTILE_ITEM, firedFromWeapon);
        {{ if disable_gravity }}setNoGravity(true);{{ end }}
    }

    public {{ registryname }}Entity(EntityType<? extends {{ registryname }}Entity> type, LivingEntity entity, Level world, ItemStack firedFromWeapon) {
        super(type, entity, world, PROJECTILE_ITEM, firedFromWeapon);
        {{ if disable_gravity }}setNoGravity(true);{{ end }}
    }

    {{ if damage > 0 }}
    @Override
    protected void doPostHurtEffects(LivingEntity entity) {
        super.doPostHurtEffects(entity);
        entity.setArrowCount(entity.getArrowCount() - 1);
    }
    {{ end }}

    {{ if knockback > 0 }}
    @Override
    protected void onHitEntity(EntityHitResult result) {
        super.onHitEntity(result);
        if (result.getEntity() instanceof LivingEntity living) {
            living.knockback((double){{ knockback }} * 0.5, result.getEntity().getX() - this.getX(), result.getEntity().getZ() - this.getZ());
        }
    }
    {{ end }}

    {{ if on_hit_effect }}
    @Override
    protected void onHitBlock(BlockHitResult result) {
        super.onHitBlock(result);
        // TODO: add block hit effect
    }
    {{ end }}

    @Override
    public ItemStack getItem() {
        return PROJECTILE_ITEM;
    }

    {{ if disable_gravity }}
    @Override
    public boolean isNoGravity() {
        return {{ disable_gravity }};
    }
    {{ end }}

    // Start of user code block projectile methods
    // End of user code block projectile methods
}