modLoader="javafml"
loaderVersion="[4,)"
license="{{ license }}"

[[mods]]
modId="{{ modid }}"
version="{{ version }}"
displayName="{{ modname }}"
{{ if update_url != "" }}
updateJSONURL="{{ update_url }}"
{{ end }}
{{ if website_url != "" }}
displayURL="{{ website_url }}"
{{ end }}
{{ if mod_picture != "" }}
logoFile="logo.png"
{{ end }}
{{ if credits != "" }}
credits="{{ credits }}"
{{ end }}
{{ if author != "" }}
authors="{{ author }}"
{{ end }}
{{ if description != "" }}
description="{{ description }}"
{{ end }}
{{ if is_server_side }}
displayTest="IGNORE_SERVER_VERSION"
{{ end }}
{{ if needs_enum_extensions }}
enumExtensions="META-INF/enumextensions.json"
{{ end }}

# Start of user code block mod configuration
# End of user code block mod configuration

{{ if needs_mixins }}
[[mixins]]
    config = "{{ modid }}.mixins.json"
{{ end }}