package {{ package }}.init;

import net.neoforged.neoforge.event.furnace.FurnaceFuelBurnTimeEvent;
import net.neoforged.bus.api.SubscribeEvent;
import net.neoforged.fml.common.EventBusSubscriber;

@EventBusSubscriber(modid = {{ JavaModName }}.MODID)
public class {{ JavaModName }}Fuels {
    @SubscribeEvent
    public static void furnaceFuelBurnTime(FurnaceFuelBurnTimeEvent event) {
        {{ for fuel in fuels }}
        if (event.getItemStack().is({{ fuel.item }}))
            event.setBurnTime({{ fuel.burn_time }});
        {{ end }}
    }
}